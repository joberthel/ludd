{
  "extends": "@sindresorhus/tsconfig",
  "compilerOptions": {
    "jsx": "react-jsx",
    "rootDir": "source",
    "module": "Node16",
    "moduleResolution": "node16",
    "outDir": "dist"
  },
  "include": ["source"],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
