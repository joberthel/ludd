{
  "extends": "@sindresorhus/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "rootDir": "source",
    "module": "Node16",
    "moduleResolution": "node16",
    "outDir": "dist"
  },
  "include": ["source"],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/test-helpers.ts"
  ]
}
