{
  "name": "ludd-monorepo",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf coverage packages/*/dist",
    "build": "pnpm clean && pnpm -r run build && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "commitlint": "commitlint"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
