{
  "name": "ludd",
  "type": "module",
  "version": "0.0.0",
  "license": "MIT",
  "bin": "dist/cli.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "ink": "^4.1.0",
    "pastel": "^2.0.0",
    "react": "^18.2.0",
    "zod": "^3.21.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@sindresorhus/tsconfig": "^3.0.1",
    "@types/react": "^18.0.32",
    "chalk": "^5.2.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "ink-testing-library": "^4.0.0",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.0",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^5.0.3",
    "vitest": "^5.0.5"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "commit-msg": "npx --no -- commitlint --edit $1"
  },
  "lint-staged": {
    "*": "eslint --fix"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "simple-git-hooks@2.14.0": true
  }
}
